# Postgres (本番用 / Vercel Postgres / Neonなど)
# 未設定の場合はローカルSQLite (data/election.db) を使用
POSTGRES_URL=

# 管理画面のBasic認証 (必須)
ADMIN_USER=admin
ADMIN_PASS=change-me

# 投票者ハッシュ用ソルト (任意の長い文字列にしてください)
VOTER_SALT=replace-with-random-secret

# 投票期間 (任意 ISO8601 / 未設定なら無制限)
# 例: 2026-06-10T00:00:00+09:00
VOTE_START=
VOTE_END=

# 手動クローズ ("true" で投票停止)
VOTE_CLOSED=false
